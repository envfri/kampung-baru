{
  "name": "bupi",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @kb/server",
    "dev:game": "npm run dev -w @kb/game",
    "dev:admin": "npm run dev -w @kb/admin",
    "build": "npm run build -w @kb/game && npm run build -w @kb/admin && npm run build -w @kb/server",
    "start": "node apps/server/dist/index.js",
    "test": "npm test -w @kb/server",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:duel": "node scripts/e2e-duel.mjs",
    "test:e2e:akun": "node scripts/e2e-akun.mjs",
    "test:e2e:kunjungan": "node scripts/e2e-kunjungan.mjs",
    "test:e2e:rumah": "node scripts/e2e-rumah.mjs",
    "test:e2e:alun": "node scripts/e2e-alun.mjs",
    "test:e2e:situs": "node scripts/e2e-situs.mjs",
    "test:e2e:bareng": "node scripts/e2e-bareng.mjs",
    "test:e2e:admin": "node scripts/e2e-admin.mjs",
    "icons": "node --import tsx scripts/make-icons.mjs",
    "site-assets": "node --import tsx scripts/site-assets.mjs",
    "instagram": "node --import tsx scripts/instagram.mjs",
    "changelog": "node --import tsx scripts/changelog.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/envfri/kampung-baru.git"
  }
}
