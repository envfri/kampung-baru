# Salin ke .env lalu isi. Semua opsional untuk pengembangan lokal.

NODE_ENV=development
PORT=8787
PUBLIC_URL=http://localhost:8787
# Di balik reverse proxy (Nginx, Caddy, Cloudflare): isi 1 agar IP pemain terbaca benar
TRUST_PROXY=0

# Database. Kosongkan untuk PGlite (Postgres di dalam proses, data di .data/pglite) — cocok untuk dev.
DATABASE_URL=
# Redis opsional, untuk rate limit bersama saat server lebih dari satu instance
REDIS_URL=

# Admin pertama (dibuat otomatis jika tabel admin masih kosong)
ADMIN_EMAIL=admin@kampungbulu.local
ADMIN_PASSWORD=ganti-dengan-password-panjang

# Login Google (Google Cloud Console > Credentials > OAuth client ID tipe Web)
GOOGLE_CLIENT_ID=
# Login Facebook (developers.facebook.com > App > Facebook Login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Email (kode masuk & notifikasi) lewat Mailketing: https://mailketing.co.id/docs/send-email-via-api/
# Token dari menu Integrasi → Email Application API. Tanpa token, kode masuk hanya dicatat di log server (mode dev).
MAILKETING_API_TOKEN=
# Pengirim; domainnya harus sudah aktif di Mailketing → Setup Domain
MAIL_FROM=Kampung Bulu <noreply@kampungbulu.local>
# MAILKETING_BASE_URL=https://api.mailketing.co.id

# Pembayaran Mutiara: zepay (QRIS, default produksi), midtrans, atau mock (simulasi, default dev)
PAYMENT_PROVIDER=mock
# ZePay (https://payment.envfri.com/docs). Kunci zpk_test_/zsk_test_ = mode uji, zpk_live_/zsk_live_ = uang sungguhan.
ZEPAY_KEY_ID=
ZEPAY_SECRET=
# Opsional: secret webhook (whsec_…). Kosongkan bila webhook didaftarkan dari admin → Pembayaran (secret disimpan di database).
ZEPAY_WEBHOOK_SECRET=
# Masa berlaku QR dalam menit (5–1440)
ZEPAY_EXPIRES_MINUTES=30
# ZEPAY_BASE_URL=https://payment.envfri.com
# Midtrans (alternatif)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false

# Notifikasi push (Web Push). Kosongkan: kunci dibuat otomatis & disimpan di database.
# Buat sendiri dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kampungbulu.local
